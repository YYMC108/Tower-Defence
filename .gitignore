# ─────────────────────────────────────────────────────────────
# Godot 4+ specific ignores
# ─────────────────────────────────────────────────────────────

# Godot 的导入缓存与编辑器状态。绝对不要提交，也不要手动删除正在编辑的项目里的它。
.godot/

# Godot 4.3 之前的旧缓存目录（若存在）
/.import/

# 导出产物
/build/
/export/
*.exe
*.pck
*.zip
*.dmg
*.app
*.apk
*.aab
*.x86_64
*.wasm

# 导出预设里可能含本机绝对路径与签名凭据，不入库。
# 如果你希望团队共享导出配置，删掉下面这行并在群里说一声。
export_presets.cfg

# C# / .NET 产物（本项目用 GDScript，保留以防将来引入）
.mono/
data_*/
*.csproj
*.sln
*.user

# 平台导出中间目录
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# ─────────────────────────────────────────────────────────────
# 操作系统与编辑器噪音
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/
*.code-workspace
