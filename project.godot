; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign value to parameters

config_version=5

[application]

config/name="Tower Defence"
config/description="2D 像素风闯关塔防"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
; 主场景。M1 直接用战斗场景，以后有菜单了改成 boot/main_menu。
run/main_scene="res://scenes/battle/battle_root.tscn"

[autoload]

; 顺序有意义：SaveManager 必须在 GameState 之前，
; 因为 GameState._ready() 会调用 SaveManager.load_game()。
SaveManager="*res://autoload/save_manager.gd"
GameState="*res://autoload/game_state.gd"

[display]

; 像素风基准分辨率（16:9）。改这里要同步检查像素美术的缩放倍数。
window/size/viewport_width=480
window/size/viewport_height=320
window/size/window_width_override=1280
window/size/window_height_override=720
; scale_mode=integer：整数倍缩放，避免像素大小不一致导致的抖动与糊边。
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[input]

; --- 移动：WASD 与方向键等价（键盘移动）---
move_left={
