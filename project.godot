[layer_names]

; 2D 物理层命名。脚本中一律用名字查询，禁止硬编码层号。
2d_physics/layer_1="terrain"
2d_physics/layer_2="enemy"
2d_physics/layer_3="tower"
2d_physics/layer_4="player"
2d_physics/layer_5="projectile"
2d_physics/layer_6="decoration"
2d_physics/layer_7="ui"

[rendering]

; 关键：像素风必须用 Nearest。Godot 默认是 Linear，会让像素画模糊。
; 枚举顺序为 Nearest, Linear, Linear Mipmap, Nearest Mipmap → Nearest = 0
textures/canvas_textures/default_texture_filter=0
; 像素风关闭 2D 抗锯齿（默认 0，显式写出以防被误改）
anti_aliasing/quality/msaa_2d=0
rendering_device/driver.windows="d3d12"
